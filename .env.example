# Скопируйте в .env и поменяйте пароль. Реальные пароли в репозиторий не коммитятся.

# --- PostgreSQL ---
POSTGRES_USER=dashboard
POSTGRES_PASSWORD=change-me
POSTGRES_DB=dashboard
# Вне Docker замените host "db" на localhost. Принимается и postgresql+asyncpg://… (формат Python-версии).
DATABASE_URL=postgresql://dashboard:change-me@db:5432/dashboard
# Для интеграционных тестов (cargo test): роль с правом CREATEDB, тесты создают и удаляют свои базы.
# TEST_DATABASE_URL=postgresql://dashboard:change-me@localhost:5432/dashboard

# --- API ---
API_HOST=0.0.0.0
API_PORT=8080
# Включите после выкладки фронтенда и создания личных учёток по DEPLOY.md.
COORDINATOR_ACCOUNTS_ENABLED=false
# Общий ключ для прежних установок. В режиме личных учёток проверяются только личные данные входа.
# COORDINATOR_ACCESS_KEY=

# --- Push по сигналам колокольчика ---
# Для включения нужны личные учётные записи и серверные учётные данные Google (DEPLOY.md).
MOBILE_PUSH_ENABLED=false
FIREBASE_PROJECT_ID=underctrl-d087a

# --- Источник данных ---
JSON_SOURCE_PATH=/data/character_problems.json
IMPORT_POLL_INTERVAL_SECONDS=1.0
# Часовой пояс для дат без зоны (формат справочника "YYYY-MM-DD HH:MM:SS")
SOURCE_NAIVE_TIMEZONE=UTC
# Запускать импортёр внутри процесса API (удобно для локальной разработки)
IMPORTER_EMBEDDED=false

# --- Приёмник заявок веб-формы ---
# Оставьте обе строки пустыми, чтобы отключить импорт. Токен чтения задаётся только на сервере.
# INCIDENT_FORM_RELAY_URL=https://85.202.205.57/v1/submissions
# INCIDENT_FORM_READ_TOKEN=
INCIDENT_FORM_POLL_INTERVAL_SECONDS=3

# --- Демо-режим фронтенда ---
# POST /api/v1/demo и PUT /api/v1/incidents переписывают файл JSON_SOURCE_PATH (каталог должен быть доступен на запись).
# Включать только на тестовом контуре с отдельной выгрузкой.
DEMO_API_ENABLED=false
# Эталонная выгрузка для сценария reset, например /data/seed.json; пусто — reset недоступен.
DEMO_SEED_PATH=

# --- Бизнес-правила ---
COORDINATOR_GROUP_NAME=КЦ ИТ Координаторы Массовых Инцидентов
CRITICAL_RESOLVED_WINDOW_HOURS=24
DEADLINE_WARNING_MINUTES=60

# --- ITSM ---
# Плейсхолдеры шаблона: {base_url} (из ITSM_BASE_URL), {sysId}, {id}.
# Пустой ITSM_BASE_URL при шаблоне с {base_url} -> itsmUrlTemplate/itsmUrl = null.
ITSM_BASE_URL=
ITSM_URL_TEMPLATE={base_url}/incidents/{sysId}

# --- SSE ---
SSE_POLL_INTERVAL_SECONDS=0.5
SSE_HEARTBEAT_SECONDS=15
EVENTS_RETENTION=10000

# --- Прочее ---
LOG_LEVEL=INFO
# Фронтенд по умолчанию ходит через Vite-прокси на http://localhost:8080; CORS нужен только без прокси
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
DEFAULT_USER_ID=coordinator

# --- Локальная LLM (llama-server, OpenAI-совместимый API) ---
# По умолчанию выключено: импортёр не ставит задачи, API отдаёт разбор по правилам, ai-worker простаивает.
# LLM_ENABLED и LLM_MODEL/LLM_MODEL_REVISION должны совпадать у importer, api и ai-worker.
LLM_ENABLED=false
LLM_MODEL=qwen-local
# Метка весов за алиасом (например, первые 8 символов SHA-256 GGUF); смена ставит выжимки заново.
LLM_MODEL_REVISION=
# Адрес с /v1 нужен только ai-worker. Реальный адрес задаётся на сервере в env_file worker, не здесь.
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=60
LLM_MAX_TOKENS=200
LLM_MAX_ATTEMPTS=3
LLM_POLL_INTERVAL_SECONDS=1
LLM_LEASE_SECONDS=120
LLM_INPUT_MAX_CHARS=3000
